{
  "domains": [
    {
      "id": "meaning-existence",
      "name": "人生意义与存在",
      "definition": "用户卡住的不是单个现实事项，而是活着为了什么、我是谁、为什么提不起劲。",
      "common_user_phrasings": [
        "我活着到底为了什么",
        "为什么什么都提不起劲",
        "我不知道人生的意义是什么"
      ],
      "keywords": ["意义", "空虚", "虚无", "价值", "我是谁", "为什么活"],
      "preferred_lens_clusters": ["meaning_under_suffering", "detachment_freedom", "conceptual_clarity"],
      "preferred_sage_names": ["维克多·弗兰克尔", "克尔凯郭尔", "释迦牟尼", "庄子", "苏格拉底"]
    },
    {
      "id": "anxiety-pain-attachment",
      "name": "焦虑、痛苦、情绪与执念",
      "definition": "情绪已经主导判断，用户先需要去雾、降温、切开执念。",
      "common_user_phrasings": [
        "我停不下来地焦虑",
        "我总在反刍",
        "我控制不住自己的情绪"
      ],
      "keywords": ["焦虑", "痛苦", "失眠", "执念", "嫉妒", "愤怒", "反刍"],
      "preferred_lens_clusters": ["suffering_detachment", "stoic_control", "detachment_freedom"],
      "preferred_sage_names": ["释迦牟尼", "爱比克泰德", "塞涅卡", "斯宾诺莎", "庄子"]
    },
    {
      "id": "relationships-family",
      "name": "关系、婚姻、家庭、亲子",
      "definition": "关系中的责任、边界、忠诚、伤害、照顾和退出判断。",
      "common_user_phrasings": [
        "我要不要离婚",
        "父母控制我怎么办",
        "我和伴侣总在同一个地方吵"
      ],
      "keywords": ["离婚", "伴侣", "孩子", "父母", "边界", "原谅", "责任", "孝顺"],
      "preferred_lens_clusters": ["role_ethics", "love_truth", "freedom_reciprocity"],
      "preferred_sage_names": ["孔子", "孟子", "耶稣", "西蒙娜·德·波伏娃", "亚里士多德"]
    },
    {
      "id": "career-development",
      "name": "职业选择与个人发展",
      "definition": "路径选择、能力发展、人生轨道和成长代价。",
      "common_user_phrasings": [
        "该转行吗",
        "稳定还是更大成长",
        "我是不是走错路了"
      ],
      "keywords": ["辞职", "转行", "成长", "方向", "天赋", "前途", "平台"],
      "preferred_lens_clusters": ["virtue_habit", "will_and_action", "conceptual_clarity"],
      "preferred_sage_names": ["亚里士多德", "王阳明", "曾国藩", "苏格拉底"]
    },
    {
      "id": "entrepreneurship-strategy",
      "name": "创业、竞争、战略与博弈",
      "definition": "多方博弈、资源有限、时机和胜率判断。",
      "common_user_phrasings": [
        "该不该创业",
        "合伙人不靠谱怎么办",
        "现在该进攻还是收缩"
      ],
      "keywords": ["创业", "市场", "竞争", "谈判", "合伙", "定位", "融资", "止损"],
      "preferred_lens_clusters": ["strategic_realism", "power_realism", "will_and_action"],
      "preferred_sage_names": ["孙子", "韩非子", "马基雅维利", "王阳明", "稻盛和夫"]
    },
    {
      "id": "management-leadership-power",
      "name": "组织管理、领导、权力与责任",
      "definition": "带人、设结构、奖惩、信任、文化与责任归位。",
      "common_user_phrasings": [
        "员工不服怎么办",
        "该不该强硬",
        "团队开始失控了"
      ],
      "keywords": ["团队", "管理", "领导", "激励", "奖惩", "信任", "责任", "文化"],
